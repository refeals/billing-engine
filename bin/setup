#!/usr/bin/env bash
# Installs dependencies and prepares the database for both apps. Safe to re-run.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

echo "== API: gems and database =="
(cd "$root/api" && bin/setup --skip-server)

echo "== Web: packages =="
(cd "$root/web" && pnpm install)

echo "Done. Start both apps with bin/dev."
